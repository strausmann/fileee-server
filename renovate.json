{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":enableVulnerabilityAlerts"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch", "pin", "digest"], "automerge": true },
    { "matchDepTypes": ["devDependencies"], "automerge": true },
    { "matchManagers": ["github-actions", "dockerfile"], "automerge": true },
    { "matchUpdateTypes": ["major"], "automerge": false }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/Dockerfile$/"],
      "matchStrings": ["INFISICAL_CLI_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "Infisical/infisical",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^infisical-cli/v(?<version>.*)$"
    }
  ]
}
